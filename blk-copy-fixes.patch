--- a/block/blk-copy.c
+++ b/block/blk-copy.c
@@ static void blkdev_end_copy_sync(const struct blk_copy_params *params)
 {
 	struct blkdev_copy_sync_ctx *ctx = params->private;
 
+	/* BUG FIX: without this the sync caller always sees status == 0 */
+	ctx->status = params->status;
 	complete(&ctx->compl);
 }
@@ blkdev_copy_chunk()
 	spin_lock_init(&ctx->lock);
 	ctx->params = params;
 	ctx->phase = BLKDEV_TRANSLATE_LBAS;
 	ctx->translation_complete = blkdev_translation_complete;
+	/*
+	 * BUG FIX: one reference per ctx (dropped once in the BLKDEV_COPY
+	 * completion), not one per source bio.  With >1 source bio in a ctx
+	 * the count never reached 0 and the sync wait hung.
+	 */
+	atomic_inc(&params->copy_ctx_count);
@@ (inside the REQ_OP_COPY_SRC loop)
-		atomic_inc(&params->copy_ctx_count);
 		scoped_guard(spinlock_irqsave, &ctx->lock)
 			ctx->bio_count++;
@@ (label free_ctx)
 free_ctx:
+	atomic_dec(&params->copy_ctx_count);
 	kfree(ctx);
 	return -ENOMEM;
@@ blkdev_copy_offload()
+	/* BUG FIX: zero segment limits give a 0-byte chunk => endless loop */
+	if (!params->in_bdev->bd_queue->limits.max_copy_src_segments ||
+	    !params->out_bdev->bd_queue->limits.max_copy_dst_segments)
+		return -EOPNOTSUPP;
+
 	ret = blkdev_copy_check_params(params, &len);
@@
-    pr_info("[BLK_COPY] max_copy in=%u out=%u || Current data length=%lu\n", 
+    pr_info("[BLK_COPY] max_copy in=%u out=%u || Current data length=%llu\n",
         bdev_max_copy_sectors(params->in_bdev),
-        bdev_max_copy_sectors(params->out_bdev), params->len);
+        bdev_max_copy_sectors(params->out_bdev), (u64)params->len);
@@ (submission loop)
 		chunk = blkdev_copy_chunk(params, &in_idx, &out_idx, &in_offset,
 					  &out_offset, chunk);
+		if (chunk < 0) {
+			/* BUG FIX: a negative chunk made offset go backwards */
+			scoped_guard(spinlock_irqsave, &params->lock)
+				if (!params->status)
+					params->status = errno_to_blk_status(chunk);
+			break;
+		}
 	}
