if (!is_alive(sbi, entry, &dni, start_addr + off, &nofs))
    continue;

pr_info("[F2FS_GC_SRC] victim_seg=%u off=%d src_blkaddr=%u "
        "nid=%u ino=%u ofs_in_node=%u nofs=%u\n",
        segno,
        off,
        start_addr + off,
        dni.nid,
        dni.ino,
        le16_to_cpu(entry->ofs_in_node),
        nofs);

pr_info("[F2FS_GC_MAP] victim_seg=%u off=%d "
        "src_blkaddr=%u ino=%lu nid=%u "
        "nofs=%u ofs_in_node=%u bidx=%lu\n",
        segno,
        off,
        start_addr + off,
        inode->i_ino,
        dni.nid,
        nofs,
        ofs_in_node,
        start_bidx);

pr_info("[F2FS_GC_COPY] "
        "SRC victim_seg=%u off=%d "
        "src_blkaddr=%u "
        "ino=%lu bidx=%lu "
        "nid=%u ofs_in_node=%u\n",
        segno,
        off,
        dn.data_blkaddr,
        inode->i_ino,
        bidx,
        dn.nid,
        dn.ofs_in_node);

pr_info("[F2FS_GC_DST] "
        "src_blkaddr=%u "
        "dst_blkaddr=%u "
        "src_seg=%u src_off=%u "
        "dst_seg=%u dst_off=%u "
        "type=%d alloc_type=%d curseg=%u\n",
        old_blkaddr,
        *new_blkaddr,
        GET_SEGNO(sbi, old_blkaddr),
        GET_BLKOFF_FROM_SEG0(sbi, old_blkaddr),
        GET_SEGNO(sbi, *new_blkaddr),
        GET_BLKOFF_FROM_SEG0(sbi, *new_blkaddr),
        type,
        curseg->alloc_type,
        curseg->segno);

pr_info("[F2FS_GC_ALLOC] "
        "old=%u new=%u "
        "old_seg=%u old_off=%u "
        "new_seg=%u new_off=%u "
        "type=%d curseg=%u alloc_type=%u "
        "from_gc=%d\n",
        old_blkaddr,
        *new_blkaddr,
        GET_SEGNO(sbi, old_blkaddr),
        GET_BLKOFF_FROM_SEG0(sbi, old_blkaddr),
        GET_SEGNO(sbi, *new_blkaddr),
        GET_BLKOFF_FROM_SEG0(sbi, *new_blkaddr),
        type,
        curseg->segno,
        curseg->alloc_type,
        from_gc);

pr_info("[F2FS_GC_PAGE] "
        "victim_seg=%u off=%d ino=%lu bidx=%lu\n",
        segno,
        off,
        inode->i_ino,
        bidx);

if (fio->io_type == FS_GC_DATA_IO) {
    pr_info("[F2FS_GC_WRITE] "
            "ino=%u old_blkaddr=%u new_blkaddr=%u "
            "old_seg=%u new_seg=%u "
            "old_off=%u new_off=%u "
            "type=%d\n",
            fio->ino,
            fio->old_blkaddr,
            fio->new_blkaddr,
            GET_SEGNO(fio->sbi, fio->old_blkaddr),
            GET_SEGNO(fio->sbi, fio->new_blkaddr),
            GET_BLKOFF_FROM_SEG0(fio->sbi, fio->old_blkaddr),
            GET_BLKOFF_FROM_SEG0(fio->sbi, fio->new_blkaddr),
            type);
}
