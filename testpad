static int move_data_block(struct inode *inode, block_t bidx,
				int gc_type, unsigned int segno, int off)
{
	struct address_space *mapping = inode->i_mapping;
	struct inode *atomic_inode = NULL;
	struct f2fs_io_info fio = {
		.sbi = F2FS_I_SB(inode),
		.ino = inode->i_ino,
		.type = DATA,
		.temp = COLD,
		.op = REQ_OP_READ,
		.op_flags = 0,
		.encrypted_page = NULL,
		.in_list = 0,
	};
	struct dnode_of_data dn;
	struct f2fs_summary sum;
	struct node_info ni;
	struct folio *folio;
	struct folio *mfolio = NULL;
	struct folio *efolio;
	block_t newaddr;
	int err = 0;
	bool copy_offload_done = false;
	bool lfs_mode = f2fs_lfs_mode(fio.sbi);
	int type = fio.sbi->am.atgc_enabled && (gc_type == BG_GC) &&
				(fio.sbi->gc_mode != GC_URGENT_HIGH) ?
				CURSEG_ALL_DATA_ATGC : CURSEG_COLD_DATA;

	f2fs_down_read(&F2FS_I(inode)->i_sem);
	if (f2fs_is_cow_file(inode)) {
		atomic_inode = igrab(F2FS_I(inode)->atomic_inode);
		if (!atomic_inode) {
			f2fs_up_read(&F2FS_I(inode)->i_sem);
			return -EBUSY;
		}
		mapping = atomic_inode->i_mapping;
	}
	f2fs_up_read(&F2FS_I(inode)->i_sem);

	/* Do not read out. */
	folio = f2fs_grab_cache_folio(mapping, bidx, false);
	if (IS_ERR(folio)) {
		err = PTR_ERR(folio);
		goto out_iput;
	}

	if (!check_valid_map(F2FS_I_SB(inode), segno, off)) {
		err = -ENOENT;

		f2fs_info(fio.sbi,
			"[F2FS_GC][FLOW=%016llx] BLOCK NOT_MIGRATED "
			"reason=invalid_at_move",
			(unsigned long long)F2FS_GC_FLOW_ID(segno, off));
		goto out;
	}

	err = f2fs_gc_pinned_control(inode, gc_type, segno);
	if (err)
		goto out;

	f2fs_info(fio.sbi,
		"[F2FS_GC][FLOW=%016llx] MIGRATION_START "
		"victim_seg=%u off=%d ino=%lu bidx=%llu",
		(unsigned long long)F2FS_GC_FLOW_ID(segno, off),
		segno, off, inode->i_ino, (unsigned long long)bidx);

	set_new_dnode(&dn, inode, NULL, NULL, 0);

	err = f2fs_get_dnode_of_data(&dn, bidx, LOOKUP_NODE);
	if (err)
		goto out;

	if (unlikely(dn.data_blkaddr == NULL_ADDR)) {
		folio_clear_uptodate(folio);
		err = -ENOENT;

		f2fs_info(fio.sbi,
			"[F2FS_GC][FLOW=%016llx] BLOCK NOT_MIGRATED "
			"reason=null_data_blkaddr",
			(unsigned long long)F2FS_GC_FLOW_ID(segno, off));

		goto put_out;
	}

	/*
	 * Do not cache encrypted data into meta inode until previous dirty
	 * data were writebacked to avoid racing between GC and flush.
	 */
	f2fs_folio_wait_writeback(folio, DATA, true, true);

	f2fs_wait_on_block_writeback(inode, dn.data_blkaddr);

	err = f2fs_get_node_info(fio.sbi, dn.nid, &ni, false);
	if (err)
		goto put_out;

	fio.folio = folio;
	fio.new_blkaddr = fio.old_blkaddr = dn.data_blkaddr;

	if (lfs_mode)
		f2fs_down_write(&fio.sbi->io_order_lock);

	set_summary(&sum, dn.nid, dn.ofs_in_node, ni.version);

	/*
	 * Allocate destination before attempting copy offload.
	 *
	 * If copy offload fails, the existing CPU fallback reuses this same
	 * destination address. Do not allocate another destination block.
	 */
	err = f2fs_allocate_data_block(fio.sbi, NULL,
					fio.old_blkaddr, &newaddr,
					&sum, type, NULL);
	if (err) {
		/*
		 * Filesystem should shutdown, no need to recover the block.
		 */
		goto up_out;
	}

	f2fs_info(fio.sbi,
		"[F2FS_GC][FLOW=%016llx] DEST_ALLOCATED "
		"SRC_PBA=0x%llx DST_PBA=0x%llx DST_SEG=%u",
		(unsigned long long)F2FS_GC_FLOW_ID(segno, off),
		(unsigned long long)fio.old_blkaddr,
		(unsigned long long)newaddr,
		GET_SEGNO(fio.sbi, newaddr));

	/*
	 * First try block-layer copy offload.
	 *
	 * This is intentionally attempted before reading the source into
	 * META_MAPPING so that a successful device copy avoids:
	 *
	 *   source device -> DRAM read
	 *   CPU memcpy()
	 *   DRAM -> destination device write
	 */
	err = f2fs_gc_copy_offload(fio.sbi,
					fio.old_blkaddr,
					newaddr,
					segno,
					off);

	if (!err) {
		copy_offload_done = true;

		f2fs_info(fio.sbi,
			"[F2FS_GC][FLOW=%016llx] COPY_OFFLOAD_SUCCESS "
			"SRC_PBA=0x%llx DST_PBA=0x%llx",
			(unsigned long long)F2FS_GC_FLOW_ID(segno, off),
			(unsigned long long)fio.old_blkaddr,
			(unsigned long long)newaddr);

		goto update_mapping;
	}

	/*
	 * Copy offload failed.
	 *
	 * Clear the error and reuse the already allocated destination block
	 * through the existing META_MAPPING + memcpy + write path.
	 */
	f2fs_info(fio.sbi,
		"[F2FS_GC][FLOW=%016llx] COPY_OFFLOAD_FAILED "
		"SRC_PBA=0x%llx DST_PBA=0x%llx ERR=%d "
		"FALLBACK=CPU_COPY",
		(unsigned long long)F2FS_GC_FLOW_ID(segno, off),
		(unsigned long long)fio.old_blkaddr,
		(unsigned long long)newaddr,
		err);

	err = 0;

	f2fs_info(fio.sbi,
		"[F2FS_GC][FLOW=%016llx] COPY_OFFLOAD_FALLBACK "
		"SRC_PBA=0x%llx DST_PBA=0x%llx METHOD=CPU",
		(unsigned long long)F2FS_GC_FLOW_ID(segno, off),
		(unsigned long long)fio.old_blkaddr,
		(unsigned long long)newaddr);

	/*
	 * Existing CPU fallback path.
	 *
	 * Read the source only after copy offload has failed.
	 */
	mfolio = f2fs_grab_cache_folio(META_MAPPING(fio.sbi),
					fio.old_blkaddr, false);
	if (IS_ERR(mfolio)) {
		err = PTR_ERR(mfolio);
		mfolio = NULL;
		goto recover_block;
	}

	fio.encrypted_page = folio_file_page(mfolio, fio.old_blkaddr);

	/* Read source block into META_MAPPING. */
	if (!folio_test_uptodate(mfolio)) {
		err = f2fs_submit_page_bio(&fio);
		if (err) {
			f2fs_folio_put(mfolio, true);
			mfolio = NULL;
			goto recover_block;
		}

		f2fs_update_iostat(fio.sbi, inode,
					FS_DATA_READ_IO, F2FS_BLKSIZE);
		f2fs_update_iostat(fio.sbi, NULL,
					FS_GDATA_READ_IO, F2FS_BLKSIZE);

		folio_lock(mfolio);

		if (unlikely(!is_meta_folio(mfolio) ||
			     !folio_test_uptodate(mfolio))) {
			err = -EIO;
			f2fs_folio_put(mfolio, true);
			mfolio = NULL;
			goto recover_block;
		}
	}

	efolio = f2fs_filemap_get_folio(META_MAPPING(fio.sbi),
					newaddr,
					FGP_LOCK | FGP_CREAT,
					GFP_NOFS);
	if (IS_ERR(efolio)) {
		err = PTR_ERR(efolio);

		f2fs_folio_put(mfolio, true);
		mfolio = NULL;

		goto recover_block;
	}

	fio.encrypted_page = &efolio->page;

	/* Write target block using the existing CPU copy path. */
	f2fs_wait_on_page_writeback(fio.encrypted_page,
					DATA, true, true);

	memcpy(page_address(fio.encrypted_page),
		folio_address(mfolio),
		PAGE_SIZE);

	f2fs_folio_put(mfolio, true);
	mfolio = NULL;

	f2fs_invalidate_internal_cache(fio.sbi,
					fio.old_blkaddr, 1);

	set_page_dirty(fio.encrypted_page);

	if (clear_page_dirty_for_io(fio.encrypted_page))
		dec_page_count(fio.sbi, F2FS_DIRTY_META);

	set_page_writeback(fio.encrypted_page);

	fio.op = REQ_OP_WRITE;
	fio.op_flags = REQ_SYNC;
	fio.new_blkaddr = newaddr;

	f2fs_submit_page_write(&fio);

	f2fs_update_iostat(fio.sbi, NULL,
				FS_GC_DATA_IO,
				F2FS_BLKSIZE);

	f2fs_put_page(fio.encrypted_page, true);

update_mapping:
	/*
	 * The destination now contains a complete copy of the source block:
	 *
	 *   - native block copy offload, or
	 *   - existing CPU read/copy/write fallback.
	 *
	 * Only now can the F2FS logical-to-physical mapping be switched.
	 */
	f2fs_update_data_blkaddr(&dn, newaddr);

	set_inode_flag(inode, FI_APPEND_WRITE);

	f2fs_info(fio.sbi,
		"[F2FS_GC][FLOW=%016llx] MAPPING_UPDATED "
		"SRC_PBA=0x%llx DST_PBA=0x%llx",
		(unsigned long long)F2FS_GC_FLOW_ID(segno, off),
		(unsigned long long)fio.old_blkaddr,
		(unsigned long long)newaddr);

	f2fs_info(fio.sbi,
		"[F2FS_GC][FLOW=%016llx] MIGRATION_COMPLETE "
		"SRC_PBA=0x%llx DST_PBA=0x%llx DST_SEG=%u "
		"ino=%lu bidx=%llu METHOD=%s",
		(unsigned long long)F2FS_GC_FLOW_ID(segno, off),
		(unsigned long long)fio.old_blkaddr,
		(unsigned long long)newaddr,
		GET_SEGNO(fio.sbi, newaddr),
		inode->i_ino,
		(unsigned long long)bidx,
		copy_offload_done ? "OFFLOAD" : "CPU_FALLBACK");

	goto up_out;

recover_block:
	if (mfolio)
		f2fs_folio_put(mfolio, true);

	if (err)
		f2fs_do_replace_block(fio.sbi, &sum,
					newaddr,
					fio.old_blkaddr,
					true, true, true);

	f2fs_info(fio.sbi,
		"[F2FS_GC][FLOW=%016llx] MIGRATION_FAILED "
		"SRC_PBA=0x%llx DST_PBA=0x%llx ERR=%d",
		(unsigned long long)F2FS_GC_FLOW_ID(segno, off),
		(unsigned long long)fio.old_blkaddr,
		(unsigned long long)newaddr,
		err);

up_out:
	if (lfs_mode)
		f2fs_up_write(&fio.sbi->io_order_lock);

put_out:
	f2fs_put_dnode(&dn);

out:
	f2fs_folio_put(folio, true);

out_iput:
	if (atomic_inode)
		iput(atomic_inode);

	return err;
}