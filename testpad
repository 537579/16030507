 #define F2FS_GC_FLOW_ID(segno, off) \
 	((((u64)(segno)) << 32) | (u64)(off))
 
+/*
+ * Copy one physical F2FS block through the block-layer copy-offload API.
+ *
+ * blk_copy_in_seg / blk_copy_out_seg terminology used in the task maps to:
+ *
+ *   in_seg  -> params.in_segs[0]
+ *   out_seg -> params.out_segs[0]
+ *
+ * The block-layer API accepts byte offsets, while f2fs_target_device()
+ * returns device-relative sectors.
+ */
+static int f2fs_gc_copy_offload(struct f2fs_sb_info *sbi,
+				block_t src_blkaddr,
+				block_t dst_blkaddr,
+				unsigned int segno,
+				int off)
+{
+	struct blk_copy_seg in_seg;
+	struct blk_copy_seg out_seg;
+	struct blk_copy_params params = { };
+	struct block_device *in_bdev;
+	struct block_device *out_bdev;
+	sector_t in_sector;
+	sector_t out_sector;
+	int ret;
+
+	in_bdev = f2fs_target_device(sbi, src_blkaddr, &in_sector);
+	out_bdev = f2fs_target_device(sbi, dst_blkaddr, &out_sector);
+
+	in_seg.pos = (loff_t)in_sector << SECTOR_SHIFT;
+	in_seg.len = F2FS_BLKSIZE;
+
+	out_seg.pos = (loff_t)out_sector << SECTOR_SHIFT;
+	out_seg.len = F2FS_BLKSIZE;
+
+	params.in_bdev = in_bdev;
+	params.in_segs = &in_seg;
+	params.in_nseg = 1;
+
+	params.out_bdev = out_bdev;
+	params.out_segs = &out_seg;
+	params.out_nseg = 1;
+
+	/*
+	 * end_io == NULL makes blkdev_copy_offload() synchronous.
+	 * The block-layer implementation waits until the copy has completed.
+	 */
+	params.end_io = NULL;
+	params.private = NULL;
+
+	f2fs_info(sbi,
+		"[F2FS_GC][FLOW=%016llx] COPY_OFFLOAD_PREPARED "
+		"SRC_PBA=0x%llx SRC_SECTOR=%llu "
+		"DST_PBA=0x%llx DST_SECTOR=%llu LEN=%u",
+		(unsigned long long)F2FS_GC_FLOW_ID(segno, off),
+		(unsigned long long)src_blkaddr,
+		(unsigned long long)in_sector,
+		(unsigned long long)dst_blkaddr,
+		(unsigned long long)out_sector,
+		F2FS_BLKSIZE);
+
+	f2fs_info(sbi,
+		"[F2FS_GC][FLOW=%016llx] COPY_OFFLOAD_ATTEMPT "
+		"SRC_PBA=0x%llx DST_PBA=0x%llx LEN=%u",
+		(unsigned long long)F2FS_GC_FLOW_ID(segno, off),
+		(unsigned long long)src_blkaddr,
+		(unsigned long long)dst_blkaddr,
+		F2FS_BLKSIZE);
+
+	ret = blkdev_copy_offload(&params);
+
+	return ret;
+}
