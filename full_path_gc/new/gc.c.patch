 /*
+ * ---------------------------------------------------------------------------
+ * Batched GC copy offload.
+ *
+ * Every data-GC path (BG GC thread, FG GC, F2FS_IOC_GARBAGE_COLLECT[_RANGE])
+ * goes through gc_data_segment(), so the hook lives there and not in the
+ * write path.  Valid blocks of one victim segment are queued, then moved with
+ * as few device copy commands as possible: one command can gather many
+ * scattered source runs into contiguous destination runs (multi-segment
+ * blk_copy_params).  Node blocks are deliberately not offloaded: their footer
+ * (cp_ver / next_blkaddr) is regenerated at write time.
+ *
+ * Offload is used only while the block queue's copy_offload_enabled node is
+ * set (checked when the batch is created and again for every command in
+ * f2fs_gc_try_copy_offload()).  sbi->copy_offload_calls counts device copy
+ * commands.  The two counters below are debug totals printed in the flush
+ * summary line.
+ * ---------------------------------------------------------------------------
+ */
+#define F2FS_GC_CPOFF_BATCH	128
+
+static atomic64_t f2fs_gc_cpoff_blocks = ATOMIC64_INIT(0);	/* by device copy */
+static atomic64_t f2fs_gc_cpoff_fallback = ATOMIC64_INIT(0);	/* by host copy */
+
+enum {
+	CPOFF_LEGACY,		/* caller must use the legacy move path */
+	CPOFF_HANDLED,		/* queued, or nothing to do (counted as moved) */
+	CPOFF_SKIPPED,		/* inode lock busy, same as legacy "continue" */
+};
+
+enum {
+	CPOFF_NONE,
+	CPOFF_ALLOCATED,	/* destination allocated, copy pending */
+	CPOFF_COPIED,		/* device copy done, mapping not switched yet */
+	CPOFF_DONE,		/* mapping switched */
+	CPOFF_REVERTED,		/* allocation undone, needs host copy */
+};
+
+struct f2fs_gc_cpoff_ent {
+	struct inode *inode;
+	block_t bidx;
+	block_t src;
+	block_t dst;
+	unsigned int segno;
+	int off;
+	u8 state;
+	struct f2fs_summary sum;
+};
+
+struct f2fs_gc_cpoff_batch {
+	struct f2fs_sb_info *sbi;
+	int gc_type;
+	int submitted;
+	unsigned int nr;
+	unsigned int nr_locked;
+	unsigned int cmds;		/* device commands issued in this flush */
+	unsigned int cmds_failed;
+	struct inode *locked[F2FS_GC_CPOFF_BATCH];
+	struct f2fs_gc_cpoff_ent e[F2FS_GC_CPOFF_BATCH];
+	struct blk_copy_seg in_segs[F2FS_GC_CPOFF_BATCH];
+	struct blk_copy_seg out_segs[F2FS_GC_CPOFF_BATCH];
+};
+
+static struct f2fs_gc_cpoff_batch *f2fs_gc_cpoff_alloc(struct f2fs_sb_info *sbi,
+						       int gc_type)
+{
+	struct f2fs_gc_cpoff_batch *b;
+	struct request_queue *q;
+	struct block_device *bdev;
+	sector_t sector;
+
+	if (f2fs_sb_has_blkzoned(sbi) || f2fs_readonly(sbi->sb))
+		return NULL;
+
+	/* copy_offload_enabled == 0 (or no device support) => legacy path */
+	bdev = f2fs_target_device(sbi, MAIN_BLKADDR(sbi), &sector);
+	if (!bdev)
+		return NULL;
+	q = bdev_get_queue(bdev);
+	if (!q || !q->copy_offload_enabled || !bdev_max_copy_sectors(bdev))
+		return NULL;
+
+	b = kvzalloc(sizeof(*b), GFP_NOFS);
+	if (b) {
+		b->sbi = sbi;
+		b->gc_type = gc_type;
+	}
+	return b;
+}
+
+static bool cpoff_inode_locked(struct f2fs_gc_cpoff_batch *b,
+			       struct inode *inode)
+{
+	unsigned int i;
+
+	for (i = 0; i < b->nr_locked; i++)
+		if (b->locked[i] == inode)
+			return true;
+	return false;
+}
+
+static void cpoff_unlock_inode(struct inode *inode)
+{
+	struct f2fs_inode_info *fi = F2FS_I(inode);
+
+	f2fs_up_write(&fi->i_gc_rwsem[READ]);
+	f2fs_up_write(&fi->i_gc_rwsem[WRITE]);
+}
+
+/*
+ * Issue device copy commands for all CPOFF_ALLOCATED entries.  Entries whose
+ * command succeeds become CPOFF_COPIED; anything else stays CPOFF_ALLOCATED
+ * and is rolled back to the host path by the caller.  One command covers many
+ * entries: contiguous blocks are merged into one segment, and several
+ * segments are sent together up to the device's segment/size limits.
+ */
+static void f2fs_gc_cpoff_run(struct f2fs_gc_cpoff_batch *b)
+{
+	struct f2fs_sb_info *sbi = b->sbi;
+	unsigned int i = 0;
+
+	while (i < b->nr) {
+		struct block_device *sbdev = NULL, *dbdev = NULL;
+		unsigned int max_blks = 0, max_src = 0, max_dst = 0;
+		unsigned int nsrc = 0, ndst = 0, cnt = 0;
+		block_t last_src = 0, last_dst = 0;
+		block_t first_src = 0, first_dst = 0;
+		u64 flow_id = 0;
+		unsigned int j, k;
+		int err;
+
+		for (j = i; j < b->nr; j++) {
+			struct f2fs_gc_cpoff_ent *e = &b->e[j];
+			struct block_device *sb_, *db_;
+			sector_t ss, ds;
+			bool new_src, new_dst;
+
+			if (e->state != CPOFF_ALLOCATED)
+				continue;
+
+			sb_ = f2fs_target_device(sbi, e->src, &ss);
+			db_ = f2fs_target_device(sbi, e->dst, &ds);
+			if (!sb_ || !db_)
+				return;
+			if (!sbdev) {
+				sbdev = sb_;
+				dbdev = db_;
+				max_blks = min(bdev_max_copy_sectors(sbdev),
+					       bdev_max_copy_sectors(dbdev)) >>
+						(F2FS_BLKSIZE_BITS - SECTOR_SHIFT);
+				max_src = sbdev->bd_queue->limits.max_copy_src_segments;
+				max_dst = dbdev->bd_queue->limits.max_copy_dst_segments;
+				if (!max_blks || !max_src || !max_dst) {
+					cpoff_dbg(sbi,
+						"[F2FS_GC:%s][FLOW=%016llx] "
+						"COPY_OFFLOAD_UNSUPPORTED "
+						"MAX_BLKS=%u MAX_SRC_SEGS=%u MAX_DST_SEGS=%u",
+						__func__,
+						(unsigned long long)F2FS_GC_FLOW_ID(e->segno, e->off),
+						max_blks, max_src, max_dst);
+					return;	/* rest falls back to host copy */
+				}
+				first_src = e->src;
+				first_dst = e->dst;
+				flow_id = F2FS_GC_FLOW_ID(e->segno, e->off);
+			} else if (sb_ != sbdev || db_ != dbdev) {
+				break;
+			}
+
+			new_src = !nsrc || e->src != last_src + 1;
+			new_dst = !ndst || e->dst != last_dst + 1;
+			if (cnt >= max_blks || nsrc + new_src > max_src ||
+			    ndst + new_dst > max_dst)
+				break;
+
+			if (new_src) {
+				b->in_segs[nsrc].pos = (loff_t)ss << SECTOR_SHIFT;
+				b->in_segs[nsrc].len = F2FS_BLKSIZE;
+				nsrc++;
+			} else {
+				b->in_segs[nsrc - 1].len += F2FS_BLKSIZE;
+			}
+			if (new_dst) {
+				b->out_segs[ndst].pos = (loff_t)ds << SECTOR_SHIFT;
+				b->out_segs[ndst].len = F2FS_BLKSIZE;
+				ndst++;
+			} else {
+				b->out_segs[ndst - 1].len += F2FS_BLKSIZE;
+			}
+			last_src = e->src;
+			last_dst = e->dst;
+			cnt++;
+		}
+
+		if (!cnt)
+			return;
+
+		b->cmds++;
+		err = f2fs_gc_try_copy_offload(sbi, sbdev, dbdev,
+					       b->in_segs, nsrc,
+					       b->out_segs, ndst, cnt,
+					       first_src, first_dst, flow_id);
+		if (err) {
+			b->cmds_failed++;
+			if (err == -EOPNOTSUPP)
+				return;		/* disabled/unsupported: stop trying */
+		} else {
+			atomic64_add(cnt, &f2fs_gc_cpoff_blocks);
+			for (k = i; k < j; k++)
+				if (b->e[k].state == CPOFF_ALLOCATED)
+					b->e[k].state = CPOFF_COPIED;
+		}
+		i = j;
+	}
+}
+
+/*
+ * Commit the queued blocks, then drop all inode locks:
+ *   1. under the dnode, re-check the block still maps to the source and
+ *      allocate the destination;
+ *   2. device copy;
+ *   3. switch the mapping (copied) or undo the allocation (not copied);
+ *   4. undone blocks go through the legacy host copy path.
+ * f2fs_lock_op() keeps a checkpoint from landing between "SIT: dst valid,
+ * src invalid" and "dnode points at dst".  All waits on writeback were done at
+ * queue time; nothing in the locked region waits on writeback.
+ */
+static void f2fs_gc_cpoff_flush(struct f2fs_gc_cpoff_batch *b)
+{
+	struct f2fs_sb_info *sbi = b->sbi;
+	int type = (sbi->am.atgc_enabled && b->gc_type == BG_GC &&
+		    sbi->gc_mode != GC_URGENT_HIGH) ?
+			CURSEG_ALL_DATA_ATGC : CURSEG_COLD_DATA;
+	unsigned int i, queued = b->nr, allocated = 0, copied = 0;
+	unsigned int committed = 0, reverted = 0, fallback = 0;
+	u64 flow_id = 0, t0 = 0;
+
+	if (!b->nr)
+		goto unlock;
+
+	flow_id = F2FS_GC_FLOW_ID(b->e[0].segno, b->e[0].off);
+	t0 = ktime_get_ns();
+	b->cmds = 0;
+	b->cmds_failed = 0;
+
+	f2fs_lock_op(sbi);
+
+	for (i = 0; i < b->nr; i++) {
+		struct f2fs_gc_cpoff_ent *e = &b->e[i];
+		struct dnode_of_data dn;
+
+		set_new_dnode(&dn, e->inode, NULL, NULL, 0);
+		if (f2fs_get_dnode_of_data(&dn, e->bidx, LOOKUP_NODE)) {
+			cpoff_dbg2(sbi,
+				"[F2FS_GC:%s][FLOW=%016llx] "
+				"BLOCK_MAPPING_LOOKUP_FAILED SRC_PBA=0x%llx",
+				__func__,
+				(unsigned long long)F2FS_GC_FLOW_ID(e->segno, e->off),
+				(unsigned long long)e->src);
+			continue;
+		}
+		if (dn.data_blkaddr == e->src &&
+		    !f2fs_allocate_data_block(sbi, NULL, e->src, &e->dst,
+					      &e->sum, type, NULL)) {
+			e->state = CPOFF_ALLOCATED;
+			allocated++;
+		} else {
+			cpoff_dbg2(sbi,
+				"[F2FS_GC:%s][FLOW=%016llx] "
+				"BLOCK_REMAPPED_SKIP SRC_PBA=0x%llx CUR_PBA=0x%llx",
+				__func__,
+				(unsigned long long)F2FS_GC_FLOW_ID(e->segno, e->off),
+				(unsigned long long)e->src,
+				(unsigned long long)dn.data_blkaddr);
+		}
+		f2fs_put_dnode(&dn);
+	}
+
+	f2fs_gc_cpoff_run(b);
+
+	for (i = 0; i < b->nr; i++) {
+		struct f2fs_gc_cpoff_ent *e = &b->e[i];
+		struct dnode_of_data dn;
+		u64 fid = F2FS_GC_FLOW_ID(e->segno, e->off);
+
+		if (e->state != CPOFF_ALLOCATED && e->state != CPOFF_COPIED)
+			continue;
+
+		if (e->state == CPOFF_COPIED) {
+			copied++;
+			set_new_dnode(&dn, e->inode, NULL, NULL, 0);
+			if (!f2fs_get_dnode_of_data(&dn, e->bidx, LOOKUP_NODE)) {
+				f2fs_invalidate_internal_cache(sbi, e->src, 1);
+				f2fs_invalidate_internal_cache(sbi, e->dst, 1);
+				f2fs_update_data_blkaddr(&dn, e->dst);
+				set_inode_flag(e->inode, FI_APPEND_WRITE);
+				f2fs_put_dnode(&dn);
+				f2fs_update_device_state(sbi, e->inode->i_ino,
+							 e->dst, 1);
+				f2fs_update_iostat(sbi, NULL, FS_GC_DATA_IO,
+						   F2FS_BLKSIZE);
+				e->state = CPOFF_DONE;
+				committed++;
+				cpoff_dbg2(sbi,
+					"[F2FS_GC:%s][FLOW=%016llx] "
+					"COPY_OFFLOAD_BLOCK_DONE "
+					"SRC_PBA=0x%llx DST_PBA=0x%llx "
+					"METHOD=DEVICE_COPY", __func__,
+					(unsigned long long)fid,
+					(unsigned long long)e->src,
+					(unsigned long long)e->dst);
+				continue;
+			}
+		}
+		/* not copied (or mapping vanished): undo the allocation */
+		f2fs_do_replace_block(sbi, &e->sum, e->dst, e->src,
+				      true, true, true);
+		e->state = CPOFF_REVERTED;
+		reverted++;
+		cpoff_dbg2(sbi,
+			"[F2FS_GC:%s][FLOW=%016llx] "
+			"COPY_OFFLOAD_BLOCK_REVERT "
+			"SRC_PBA=0x%llx DST_PBA=0x%llx FALLBACK=CPU_COPY",
+			__func__, (unsigned long long)fid,
+			(unsigned long long)e->src,
+			(unsigned long long)e->dst);
+	}
+
+	f2fs_unlock_op(sbi);
+
+	/* Host copy for the rest; inode locks are still held as legacy expects. */
+	for (i = 0; i < b->nr; i++) {
+		struct f2fs_gc_cpoff_ent *e = &b->e[i];
+		int err;
+
+		if (e->state != CPOFF_REVERTED)
+			continue;
+		fallback++;
+		atomic64_inc(&f2fs_gc_cpoff_fallback);
+		if (f2fs_meta_inode_gc_required(e->inode))
+			err = move_data_block(e->inode, e->bidx, b->gc_type,
+					      e->segno, e->off);
+		else
+			err = move_data_page(e->inode, e->bidx, b->gc_type,
+					     e->segno, e->off);
+		if (!err && (b->gc_type == FG_GC ||
+			     f2fs_meta_inode_gc_required(e->inode)))
+			b->submitted++;
+	}
+
+	cpoff_dbg(sbi,
+		"[F2FS_GC:%s][FLOW=%016llx] "
+		"COPY_OFFLOAD_FLUSH GC_TYPE=%s QUEUED=%u ALLOCATED=%u "
+		"COPIED=%u COMMITTED=%u REVERTED=%u HOST_FALLBACK=%u "
+		"CMDS=%u CMDS_FAILED=%u DUR_US=%llu "
+		"TOTAL_DEVICE_BLKS=%lld TOTAL_FALLBACK_BLKS=%lld "
+		"COPY_OFFLOAD_CALLS=%llu", __func__,
+		(unsigned long long)flow_id,
+		b->gc_type == BG_GC ? "BG" : "FG",
+		queued, allocated, copied, committed, reverted, fallback,
+		b->cmds, b->cmds_failed,
+		(unsigned long long)((ktime_get_ns() - t0) / 1000),
+		(long long)atomic64_read(&f2fs_gc_cpoff_blocks),
+		(long long)atomic64_read(&f2fs_gc_cpoff_fallback),
+		(unsigned long long)sbi->copy_offload_calls);
+
+unlock:
+	while (b->nr_locked)
+		cpoff_unlock_inode(b->locked[--b->nr_locked]);
+	memset(b->e, 0, sizeof(b->e[0]) * b->nr);
+	b->nr = 0;
+}
