+/*
+ * Queue one victim block.  Mirrors the checks of move_data_block() but never
+ * reads the source and never allocates: both happen in the flush.
+ */
+static int f2fs_gc_cpoff_queue(struct f2fs_gc_cpoff_batch *b,
+			       struct inode *inode, block_t bidx,
+			       unsigned int segno, int off)
+{
+	struct f2fs_sb_info *sbi = b->sbi;
+	struct f2fs_inode_info *fi = F2FS_I(inode);
+	struct f2fs_gc_cpoff_ent *e;
+	struct dnode_of_data dn;
+	struct node_info ni;
+	struct folio *folio;
+	u64 flow_id = F2FS_GC_FLOW_ID(segno, off);
+	bool newly = false, queued = false;
+	int ret = CPOFF_HANDLED;
+	int err;
+
+	if (!S_ISREG(inode->i_mode) || f2fs_is_cow_file(inode))
+		return CPOFF_LEGACY;
+
+	if (b->nr >= F2FS_GC_CPOFF_BATCH)
+		f2fs_gc_cpoff_flush(b);
+
+	if (!cpoff_inode_locked(b, inode)) {
+		/* same lock order and contract as the legacy phase-4 code */
+		if (!f2fs_down_write_trylock(&fi->i_gc_rwsem[WRITE])) {
+			sbi->skipped_gc_rwsem++;
+			cpoff_dbg2(sbi,
+				"[F2FS_GC:%s][FLOW=%016llx] "
+				"MIGRATION_SKIP_LOCK_BUSY ino=%lu", __func__,
+				(unsigned long long)flow_id, inode->i_ino);
+			return CPOFF_SKIPPED;
+		}
+		if (!f2fs_down_write_trylock(&fi->i_gc_rwsem[READ])) {
+			sbi->skipped_gc_rwsem++;
+			f2fs_up_write(&fi->i_gc_rwsem[WRITE]);
+			cpoff_dbg2(sbi,
+				"[F2FS_GC:%s][FLOW=%016llx] "
+				"MIGRATION_SKIP_LOCK_BUSY ino=%lu", __func__,
+				(unsigned long long)flow_id, inode->i_ino);
+			return CPOFF_SKIPPED;
+		}
+		inode_dio_wait(inode);
+		b->locked[b->nr_locked++] = inode;
+		newly = true;
+	}
+
+	/* "do not read out": only used to wait for writeback of this offset */
+	folio = f2fs_grab_cache_folio(inode->i_mapping, bidx, false);
+	if (IS_ERR(folio)) {
+		ret = CPOFF_LEGACY;
+		goto unlock;
+	}
+	if (!check_valid_map(sbi, segno, off)) {
+		cpoff_dbg2(sbi,
+			"[F2FS_GC:%s][FLOW=%016llx] "
+			"BLOCK_INVALID_SKIP victim_seg=%u off=%d", __func__,
+			(unsigned long long)flow_id, segno, off);
+		goto put_folio;
+	}
+	err = f2fs_gc_pinned_control(inode, b->gc_type, segno);
+	if (err) {
+		cpoff_dbg2(sbi,
+			"[F2FS_GC:%s][FLOW=%016llx] "
+			"MIGRATION_SKIP_PINNED err=%d", __func__,
+			(unsigned long long)flow_id, err);
+		goto put_folio;
+	}
+
+	set_new_dnode(&dn, inode, NULL, NULL, 0);
+	if (f2fs_get_dnode_of_data(&dn, bidx, LOOKUP_NODE))
+		goto put_folio;
+	if (dn.data_blkaddr == NULL_ADDR) {
+		cpoff_dbg2(sbi,
+			"[F2FS_GC:%s][FLOW=%016llx] "
+			"BLOCK_MAPPING_INVALID", __func__,
+			(unsigned long long)flow_id);
+		f2fs_put_dnode(&dn);
+		goto put_folio;
+	}
+	if (!__is_valid_data_blkaddr(dn.data_blkaddr)) {  /* NEW/COMPRESS_ADDR */
+		cpoff_dbg2(sbi,
+			"[F2FS_GC:%s][FLOW=%016llx] "
+			"COPY_OFFLOAD_INELIGIBLE blkaddr=0x%llx FALLBACK=CPU_COPY",
+			__func__, (unsigned long long)flow_id,
+			(unsigned long long)dn.data_blkaddr);
+		f2fs_put_dnode(&dn);
+		ret = CPOFF_LEGACY;
+		goto put_folio;
+	}
+
+	/* the source block must be fully on media before the device copies it */
+	f2fs_folio_wait_writeback(folio, DATA, true, true);
+	f2fs_wait_on_block_writeback(inode, dn.data_blkaddr);
+
+	if (f2fs_get_node_info(sbi, dn.nid, &ni, false)) {
+		f2fs_put_dnode(&dn);
+		goto put_folio;
+	}
+
+	e = &b->e[b->nr++];
+	e->inode = inode;
+	e->bidx = bidx;
+	e->src = dn.data_blkaddr;
+	e->dst = NULL_ADDR;
+	e->segno = segno;
+	e->off = off;
+	e->state = CPOFF_NONE;
+	set_summary(&e->sum, dn.nid, dn.ofs_in_node, ni.version);
+	f2fs_put_dnode(&dn);
+	queued = true;
+	cpoff_dbg2(sbi,
+		"[F2FS_GC:%s][FLOW=%016llx] "
+		"COPY_OFFLOAD_QUEUED ino=%lu SRC_PBA=0x%llx", __func__,
+		(unsigned long long)flow_id, inode->i_ino,
+		(unsigned long long)e->src);
+
+put_folio:
+	f2fs_folio_put(folio, true);
+unlock:
+	if (ret == CPOFF_LEGACY) {
+		/* legacy path takes the inode locks itself */
+		if (newly) {
+			b->nr_locked--;
+			cpoff_unlock_inode(inode);
+		} else {
+			f2fs_gc_cpoff_flush(b);
+		}
+	} else if (newly && !queued) {
+		b->nr_locked--;
+		cpoff_unlock_inode(inode);
+	}
+	return ret;
+}
